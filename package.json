{
  "name": "@quasibit/eleventy-plugin-schema",
  "version": "1.14.0",
  "description": "Eleventy plugin to generate JSON-LD structured data.",
  "type": "module",
  "main": ".eleventy.cjs",
  "module": ".eleventy.js",
  "exports": {
    ".": {
      "import": "./.eleventy.js",
      "require": "./.eleventy.cjs"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "demo": "npx @11ty/eleventy --input=demo --output=demo/_site --config=demo/.eleventy.js",
    "test": "npm run test:unit && npm run test:lint && npm run demo",
    "test:unit": "node --test \"test/*Test.js\"",
    "test:lint": "eslint .",
    "coverage": "c8 --all --include=\"src/**/*.js\" --reporter=text --reporter=lcov npm run test:unit",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quasibit/eleventy-plugin-schema.git"
  },
  "keywords": [
    "11ty",
    "eleventy",
    "eleventy-plugin",
    "json-ld",
    "jsonld",
    "schema",
    "structured-data",
    "seo"
  ],
  "author": {
    "name": "Nuno Freitas",
    "email": "nuno.freitas@quasibit.com",
    "homepage": "https://www.quasibit.com/"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/quasibit/eleventy-plugin-schema/issues"
  },
  "homepage": "https://github.com/quasibit/eleventy-plugin-schema#readme",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "semantic-release": "^25.0.9"
  },
  "peerDependencies": {
    "@11ty/eleventy": ">=0.11.0"
  }
}
